# ── AI Provider ───────────────────────────────────────────────────────────────
# NVIDIA (https://build.nvidia.com) — free tier available
# Required. Llama 3.1 70B, Mistral Large, Gemma 2 27B.
NVIDIA_API_KEY=nvapi-...

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres (https://supabase.com) — free tier works fine
# Used for: simulation snapshots, watchlists, price alerts, API keys
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Supabase project credentials — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# ── Caching & Rate Limiting ───────────────────────────────────────────────────
# Upstash Redis (https://upstash.com) — free tier works fine
# Optional but recommended. Without it the app runs with in-memory cache (no persistence).
UPSTASH_REDIS_REST_URL=https://[name]-[region].upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of the deployment. Used for server-to-self API calls.
# Local: http://localhost:3000  |  Production: your Vercel URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
