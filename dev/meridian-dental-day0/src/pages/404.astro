---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Meridian Dental" description="The page you're looking for doesn't exist.">
  <main class="bg-ink min-h-screen flex flex-col items-center justify-center px-8 text-center">
    <p class="uppercase text-xs tracking-[0.2em] text-bone/60 font-sans mb-6">404</p>
    <h1 class="font-display font-light text-[clamp(2.5rem,6vw,5rem)] tracking-display leading-[1.05] text-bone mb-4">
      Page not found.
    </h1>
    <p class="text-bone/70 max-w-sm leading-relaxed font-sans text-base mb-8">
      This page doesn't exist. Let's get you back.
    </p>
    <a href="/" class="bg-brass text-ink px-6 py-3 hover:bg-brass/90 font-sans text-sm font-medium">
      Go home
    </a>
  </main>
</Layout>
